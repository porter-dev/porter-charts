      "title": "Sandboxes Created (1m)",
      "type": "stat",
      "targets": [{ "expr": "sum(increase(sandbox_time_to_running_seconds_count[1m]))", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
